# Supabase: Project Settings -> Database -> Connection string -> URI
# Use the "Transaction pooler" (port 6543) for the app at runtime, and the
# direct connection (port 5432) for running migrations (drizzle-kit).
DATABASE_URL=postgres://postgres.xxxxxxxxxxxx:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

PORT=3000

# Signs every login JWT — required, the app refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Used only by src/db/seed.ts to create the first system_admin login.
SEED_ADMIN_EMAIL=admin@school.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Optional local-only fallback (matches docker-compose.yml) if you want to
# develop against a local Postgres before wiring up Supabase:
# DATABASE_URL=postgres://accounts:accounts_dev_password@localhost:5432/school_accounts
